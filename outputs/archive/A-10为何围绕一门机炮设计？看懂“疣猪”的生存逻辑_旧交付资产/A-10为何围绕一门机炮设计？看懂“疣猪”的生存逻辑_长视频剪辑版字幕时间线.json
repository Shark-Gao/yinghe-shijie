{
  "version": 1,
  "source_subtitle": "L:\\workspace\\yinghe-shijie\\videos\\exports\\长视频\\A-10为何围绕一门机炮设计？看懂“疣猪”的生存逻辑\\A-10为何围绕一门机炮设计？看懂“疣猪”的生存逻辑_长视频剪辑版中文解说.srt",
  "output_audio": "",
  "mode": "manual_jianying_voiceover",
  "voice": "由用户在剪映中配音",
  "rate": "",
  "video_duration": "00:14:48.200",
  "segments": [
    {
      "id": "subtitle_001",
      "start": "00:00:03.000",
      "end": "00:00:11.900",
      "text": "费尔柴尔德共和国A-10 “雷电”II，绰号“疣猪”"
    },
    {
      "id": "subtitle_002",
      "start": "00:00:11.933",
      "end": "00:00:17.466",
      "text": "它诞生于冷战中期， 最初就是为特定战争环境设计的"
    },
    {
      "id": "subtitle_003",
      "start": "00:00:17.900",
      "end": "00:00:22.566",
      "text": "如果冷战真的变热， 欧洲的一片地带很可能成为战场"
    },
    {
      "id": "subtitle_004",
      "start": "00:00:22.966",
      "end": "00:00:30.400",
      "text": "这片低地峡谷长约五十公里， 被称为“富尔达缺口”"
    },
    {
      "id": "subtitle_005",
      "start": "00:00:30.400",
      "end": "00:00:38.966",
      "text": "东德向西德推进的部队会经过这里， 它也是通往法兰克福和莱茵河的捷径"
    },
    {
      "id": "subtitle_006",
      "start": "00:00:39.466",
      "end": "00:00:48.099",
      "text": "一旦开战，控制这条走廊就至关重要， 缺口两侧都部署着装甲部队"
    },
    {
      "id": "subtitle_007",
      "start": "00:00:48.400",
      "end": "00:00:54.866",
      "text": "为了应对这种威胁， 美国提出了“空地一体战”作战思想"
    },
    {
      "id": "subtitle_008",
      "start": "00:00:55.333",
      "end": "00:01:08.599",
      "text": "A-10就是这套体系的关键组成部分， 一种与地面部队协同的低空“坦克杀手”"
    },
    {
      "id": "subtitle_009",
      "start": "00:01:08.600",
      "end": "00:01:16.766",
      "text": "它负责打散前线敌军编队， 高空轰炸机则负责骚扰后方补给线"
    },
    {
      "id": "subtitle_010",
      "start": "00:01:17.700",
      "end": "00:01:34.599",
      "text": "近距空中支援，顾名思义， 就是离双方部队都很近"
    },
    {
      "id": "subtitle_011",
      "start": "00:01:35.100",
      "end": "00:01:57.600",
      "text": "飞机必须能承受大量火力， 还要精确开火，避免误伤友军"
    },
    {
      "id": "subtitle_012",
      "start": "00:01:57.966",
      "end": "00:02:15.099",
      "text": "它还要随时出动， 从设施简陋的前进基地靠近前线待命"
    },
    {
      "id": "subtitle_013",
      "start": "00:02:15.400",
      "end": "00:02:26.700",
      "text": "低空飞行意味着各种武器都会瞄准它： 步枪、机枪、防空炮，甚至导弹"
    },
    {
      "id": "subtitle_014",
      "start": "00:02:27.100",
      "end": "00:02:58.366",
      "text": "A-10经常带着足以击落 其他飞机的损伤返航"
    },
    {
      "id": "subtitle_015",
      "start": "00:02:58.933",
      "end": "00:03:12.000",
      "text": "与此同时，飞机还要简单、便宜、易于制造 谁能更快制造并维护装备，谁就更有优势"
    },
    {
      "id": "subtitle_016",
      "start": "00:03:12.500",
      "end": "00:03:23.333",
      "text": "所以A-10被设想成一匹 粗壮的战场老黄牛"
    },
    {
      "id": "subtitle_017",
      "start": "00:03:23.700",
      "end": "00:03:36.499",
      "text": "飞机的核心武器在设计开始前就已确定： 通用电气GAU-8/A机炮"
    },
    {
      "id": "subtitle_018",
      "start": "00:03:36.900",
      "end": "00:03:51.099",
      "text": "这门炮长近六米， 占据机身内部大量空间，正好位于飞行员下方"
    },
    {
      "id": "subtitle_019",
      "start": "00:03:51.366",
      "end": "00:03:58.899",
      "text": "弹鼓通常可装一千一百五十发三十毫米炮弹， 供弹系统把炮弹送入七根旋转炮管"
    },
    {
      "id": "subtitle_020",
      "start": "00:03:59.166",
      "end": "00:04:15.933",
      "text": "发射后的弹壳还会被收回弹鼓， 避免留在机身内损坏飞机"
    },
    {
      "id": "subtitle_021",
      "start": "00:04:16.566",
      "end": "00:04:34.566",
      "text": "供弹和炮管旋转机构由液压马达驱动， 而液压马达由两套独立系统提供动力"
    },
    {
      "id": "subtitle_022",
      "start": "00:04:34.566",
      "end": "00:04:49.899",
      "text": "即使一台发动机或一条液压管路损坏， 飞机仍可依靠另一套系统继续飞行"
    },
    {
      "id": "subtitle_023",
      "start": "00:04:50.533",
      "end": "00:05:07.900",
      "text": "如果两套液压系统都失效， A-10还能切换到手动控制"
    },
    {
      "id": "subtitle_024",
      "start": "00:05:08.600",
      "end": "00:05:32.599",
      "text": "操纵会非常困难， 但至少还能尝试安全着陆或飞到安全空域"
    },
    {
      "id": "subtitle_025",
      "start": "00:05:33.266",
      "end": "00:05:51.699",
      "text": "这种冗余设计遍布A-10， 起落架和油箱也都为受损后的返航做了准备"
    },
    {
      "id": "subtitle_026",
      "start": "00:05:52.000",
      "end": "00:06:07.999",
      "text": "飞机不可能把每个部位都装上厚重装甲， 所以A-10优先保护最重要的部件：飞行员"
    },
    {
      "id": "subtitle_027",
      "start": "00:06:08.600",
      "end": "00:06:22.266",
      "text": "飞行员坐在钛合金装甲舱里， 座舱盖则使用防弹玻璃"
    },
    {
      "id": "subtitle_028",
      "start": "00:06:22.700",
      "end": "00:06:36.000",
      "text": "这些防护主要用来抵御轻武器、 防空炮和导弹产生的破片"
    },
    {
      "id": "subtitle_029",
      "start": "00:06:36.700",
      "end": "00:06:54.166",
      "text": "A-10还携带大量箔条和红外诱饵弹， 分别用来迷惑雷达制导和热寻的导弹"
    },
    {
      "id": "subtitle_030",
      "start": "00:06:54.866",
      "end": "00:07:05.533",
      "text": "机身共有十六组布撒装置， 既能自动触发，也能由飞行员手动释放"
    },
    {
      "id": "subtitle_031",
      "start": "00:07:05.966",
      "end": "00:07:16.766",
      "text": "发动机和尾翼的奇特布局， 同样是为了降低红外导弹锁定它的机会"
    },
    {
      "id": "subtitle_032",
      "start": "00:07:17.300",
      "end": "00:07:32.099",
      "text": "高温尾气被机身布局遮挡， 巨大的垂尾则帮助飞机保持稳定"
    },
    {
      "id": "subtitle_033",
      "start": "00:07:32.500",
      "end": "00:08:01.466",
      "text": "机炮安装在机身中线上， 减少后坐力把飞机推离瞄准线的影响"
    },
    {
      "id": "subtitle_034",
      "start": "00:08:01.933",
      "end": "00:08:15.499",
      "text": "机炮后坐力约为四十四点五千牛， 但A-10通常只连续射击一到两秒"
    },
    {
      "id": "subtitle_035",
      "start": "00:08:15.500",
      "end": "00:08:41.966",
      "text": "高置发动机还能减少土跑道上的尘土被吸入， 让飞机可以从偏远机场运作"
    },
    {
      "id": "subtitle_036",
      "start": "00:08:42.500",
      "end": "00:09:03.666",
      "text": "大多数小型军机没有辅助动力装置， 但A-10不能依赖地面设备， 所以自行安装了一台"
    },
    {
      "id": "subtitle_037",
      "start": "00:09:04.066",
      "end": "00:09:21.399",
      "text": "机炮威力巨大，也带来新的设计难题 早期型号曾因炮口废气导致发动机失去供氧"
    },
    {
      "id": "subtitle_038",
      "start": "00:09:21.666",
      "end": "00:09:35.700",
      "text": "工程师在炮管下方加装导气槽， 并调整炮弹发射药的配方"
    },
    {
      "id": "subtitle_039",
      "start": "00:09:36.166",
      "end": "00:09:50.566",
      "text": "新配方又让残留物堆积在座舱玻璃上， 于是飞机增加了座舱清洗装置"
    },
    {
      "id": "subtitle_040",
      "start": "00:09:51.166",
      "end": "00:10:03.333",
      "text": "点火电路会在扣动扳机时持续工作， 万一发动机熄火，也能立刻重新点燃"
    },
    {
      "id": "subtitle_041",
      "start": "00:10:04.166",
      "end": "00:10:21.399",
      "text": "GAU-8“复仇者”是为 反装甲作战打造的巨炮"
    },
    {
      "id": "subtitle_042",
      "start": "00:10:21.400",
      "end": "00:10:39.533",
      "text": "部分炮弹采用铝制弹体，内部是贫铀芯 贫铀的密度远高于铅和铁"
    },
    {
      "id": "subtitle_043",
      "start": "00:10:39.866",
      "end": "00:10:51.333",
      "text": "更高的密度意味着更强的动能和穿甲能力， 贫铀弹芯撞击时还会发生自锐化"
    },
    {
      "id": "subtitle_044",
      "start": "00:10:52.133",
      "end": "00:11:04.900",
      "text": "美国曾储存大量六氟化铀形式的贫铀， 维护这些储存设施需要高昂成本"
    },
    {
      "id": "subtitle_045",
      "start": "00:11:05.400",
      "end": "00:11:21.099",
      "text": "从叙述角度看， 贫铀弹药似乎是一种低成本的消耗方式"
    },
    {
      "id": "subtitle_046",
      "start": "00:11:21.100",
      "end": "00:11:28.066",
      "text": "但贫铀弹药的环境和健康争议， 不能被简单忽略"
    },
    {
      "id": "subtitle_047",
      "start": "00:11:28.666",
      "end": "00:11:44.666",
      "text": "A-10长期面临退役争议 最初有人认为F-16可以 接替它，如今F-35也常被比较"
    },
    {
      "id": "subtitle_048",
      "start": "00:11:44.866",
      "end": "00:11:57.799",
      "text": "双方都有道理： F-16和A-10必要时都能 携带相近的弹药量"
    },
    {
      "id": "subtitle_049",
      "start": "00:11:57.900",
      "end": "00:12:11.933",
      "text": "但给F-16挂上重型装备， 会削弱它最重要的机动性和空战动能"
    },
    {
      "id": "subtitle_050",
      "start": "00:12:12.333",
      "end": "00:12:25.133",
      "text": "F-16是多用途战斗机， A-10却只为一个核心任务打造"
    },
    {
      "id": "subtitle_051",
      "start": "00:12:25.766",
      "end": "00:12:28.466",
      "text": "F-35更像一名拳击手 依靠隐身和机动先出手"
    },
    {
      "id": "subtitle_052",
      "start": "00:12:28.466",
      "end": "00:12:35.100",
      "text": "它在远距离打击后迅速脱离 两架飞机来自不同时代，不能直接比较"
    },
    {
      "id": "subtitle_053",
      "start": "00:12:35.100",
      "end": "00:12:38.766",
      "text": "F-35的设计目标，是在 内部武器舱中携带较少的武器载荷"
    }
  ],
  "notes": "片头增加3秒原创标题卡；原片正式内容从00:00:14.800开始接入，原片15:00.000之后为频道推广段并已移除。MP4保留源片原声，中文解说由用户在剪映中配音。"
}
