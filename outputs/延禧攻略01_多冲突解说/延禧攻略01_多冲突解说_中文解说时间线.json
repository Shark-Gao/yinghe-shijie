  "voice": "中文女",
  "rate": "+12%",
  "video_duration": "243.302",
  "segments": [
    {
      "id": "seg_001",
      "start": "00:00:01.100",
      "end": "00:00:09.800",
      "text": "先别急，这声“混账贱婢”不是无缘无故；要看懂她为什么敢骂，得先看清宫里的身份差距。"
    },
    {
      "id": "seg_002",
      "start": "00:00:10.600",
      "end": "00:00:16.200",
      "text": "乌雅氏是待殿选的秀女，璎珞和吉祥只是宫女；身份刚摆明白，吉祥又弄脏了她的衣裳。"
    },
    {
      "id": "seg_003",
      "start": "00:00:44.900",
      "end": "00:00:56.900",
      "text": "吉祥已经被逼到地上，璎珞这才开口。她没硬刚，而是抓住乌雅氏马上殿选、最怕见血，把求情说成提醒——这波属于借规则救人。"
    },
    {
      "id": "seg_004",
      "start": "00:01:22.200",
      "end": "00:01:31.200",
      "text": "她用香粉把惩罚变成步步生莲，吉祥算是救下了。可璎珞自己还没站稳，还是泥菩萨过河——自身难保。"
    },
    {
      "id": "seg_005",
      "start": "00:01:31.800",
      "end": "00:01:38.650",
      "text": "光会救人还不够，璎珞还得拿到留下来的入场券。下一关，绣坊见真章。"
    },
    {
      "id": "seg_006",
      "start": "00:01:40.300",
      "end": "00:01:49.534",
      "text": "绣坊里，吉祥和玲珑同场考试，吴总管一锤定去留。这里不看情面，绣得好才有饭碗。"
    },
    {
      "id": "seg_007",
      "start": "00:01:49.700",
      "end": "00:01:54.200",
      "text": "刚开考，绣品染血，玲珑直接喊作弊！"
    },
    {
      "id": "seg_008",
      "start": "00:02:34.200",
      "end": "00:02:43.700",
      "text": "绣图刚交上去，玲珑就把两人的接力说成了作弊。吴总管还没开口，按宫规，这俩人都可能当场出局。"
    },
    {
      "id": "seg_009",
      "start": "00:02:44.100",
      "end": "00:02:57.900",
      "text": "璎珞没急着喊冤，而是把两幅绣图的交接顺序重新摆出来。她要证明的不是“我没碰”，而是这根本不是替考——先把证据摆上桌，嘴硬才没用。"
    },
    {
      "id": "seg_010",
      "start": "00:03:18.200",
      "end": "00:03:27.700",
      "text": "她交给吉祥时，牡丹还没绣完；吉祥交回来时，锦鸡也只绣了几针。明明是接力，玲珑却想说成代打。"
    },
    {
      "id": "seg_011",
      "start": "00:03:28.600",
      "end": "00:03:36.300",
      "text": "所以这场翻盘的关键，不是吵赢，而是让事实自己开口。吴总管会不会买账？马上见分晓。"
    }
  ],
