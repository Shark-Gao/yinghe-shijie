{
  "source_subtitle": "L:\\workspace\\yinghe-shijie\\outputs\\延禧攻略07_时间线01.srt",
  "video_duration": "00:04:10.834",
  "segments": [
    {"start": "00:00:00.800", "end": "00:00:04.800", "text": "孔雀羽线刚丢，璎珞已经决定在离开绣房前抓住窃贼。"},
    {"start": "00:00:05.500", "end": "00:00:09.500", "text": "她先提醒众人，皇后赏赐的东西不能随便乱碰。"},
    {"start": "00:00:17.500", "end": "00:00:21.500", "text": "表面上是把礼物供起来，实际上是在给窃贼设局。"},
    {"start": "00:00:57.500", "end": "00:01:01.500", "text": "证据还没摆到台面上，璎珞已经当众点名玲珑。"},
    {"start": "00:01:02.000", "end": "00:01:06.000", "text": "玲珑立刻否认，第一轮交锋先变成了“谁才是贼”。"},
    {"start": "00:01:06.500", "end": "00:01:10.500", "text": "璎珞不靠直觉，先把时间、动线和受罚后果一条条摆出来。"},
    {"start": "00:01:13.000", "end": "00:01:17.000", "text": "她抓住三处细节，把嫌疑锁在熟悉绣房的人身上。"},
    {"start": "00:01:21.000", "end": "00:01:25.000", "text": "她还故意说要把礼物供起来，等对方再次上钩。"},
    {"start": "00:01:32.000", "end": "00:01:36.000", "text": "玲珑改口说只是偷偷摸过，却始终不肯承认盗窃。"},
    {"start": "00:01:42.000", "end": "00:01:46.000", "text": "璎珞要把人带去张嬷嬷处对质，玲珑立刻哭喊自证清白。"},
    {"start": "00:01:52.000", "end": "00:01:56.000", "text": "众人开始替玲珑求情，现场从查贼变成了谁有证据。"},
    {"start": "00:02:17.000", "end": "00:02:21.000", "text": "玲珑的情绪越激烈，反而越让这场争执失去重点。"},
    {"start": "00:02:28.000", "end": "00:02:32.000", "text": "璎珞没有继续硬逼，只留下一句“人在做天在看”。"},
    {"start": "00:02:59.800", "end": "00:03:03.800", "text": "几小时后，吴总管终于抓到所谓的盗贼。"},
    {"start": "00:03:06.000", "end": "00:03:10.000", "text": "人赃并获的证据摆出来，吉祥当场慌了。"},
    {"start": "00:03:13.000", "end": "00:03:17.000", "text": "吉祥拼命喊冤，但两天期限和抓人的命令都压了下来。"},
    {"start": "00:03:20.000", "end": "00:03:24.000", "text": "张嬷嬷想求情，吴总管却说人赃并获，不必再查。"},
    {"start": "00:03:27.000", "end": "00:03:31.000", "text": "在他们眼里，抓到一个人比查清真相更重要。"},
    {"start": "00:03:36.000", "end": "00:03:40.000", "text": "偷孔雀羽线按宫规可能杖毙，吉祥成了最危险的替罪羊。"},
    {"start": "00:04:02.000", "end": "00:04:06.000", "text": "这场高能真正的反转是：抓到人，不等于抓到真凶。"}
  ]
}
