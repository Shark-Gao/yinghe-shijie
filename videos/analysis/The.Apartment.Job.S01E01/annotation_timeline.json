{
  "version": 1,
  "source_subtitle": "source_zh-CN.srt",
  "video_duration": "00:04:01.477",
  "segments": [
    {"start": "00:00:00.300", "end": "00:00:05.300", "text": "三个月内凑齐一百亿，否则养父就换不回来。"},
    {"start": "00:00:06.000", "end": "00:00:11.000", "text": "对方把这笔债，直接绑到了养父身上。"},
    {"start": "00:00:20.800", "end": "00:00:25.800", "text": "借条上写着：借来的三千万，抵押物却是朴海江。"},
    {"start": "00:00:28.000", "end": "00:00:33.000", "text": "儿子终于明白，自己也成了债务的一部分。"},
    {"start": "00:01:12.900", "end": "00:01:17.700", "text": "三个月、一百亿、一个被扣押的养父。"},
    {"start": "00:01:36.500", "end": "00:01:41.500", "text": "养父不再让他救自己，只劝他去过自己的生活。"},
    {"start": "00:01:58.000", "end": "00:02:03.000", "text": "回到公司，所有人都知道，这次的代价不是普通欠款。"},
    {"start": "00:02:27.000", "end": "00:02:32.000", "text": "海江先做的，是把兄弟们全部遣散。"},
    {"start": "00:02:47.000", "end": "00:02:52.000", "text": "但他们转身离开后，谁也没有真的辞职。"},
    {"start": "00:03:08.000", "end": "00:03:13.000", "text": "他们记得的，不是老板发过多少钱，而是养父替他们托住的人生。"},
    {"start": "00:03:29.500", "end": "00:03:34.500", "text": "兄弟们真正要救的，已经不是一个老板，而是把他们带大的人。"},
    {"start": "00:03:45.000", "end": "00:03:50.000", "text": "这群人最后把老板和员工，改成了一起活、一起死。"},
    {"start": "00:03:56.800", "end": "00:04:01.000", "text": "一百亿未解，但他们决定一起扛。"}
  ]
}
